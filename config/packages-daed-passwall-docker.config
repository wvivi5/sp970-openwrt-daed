# daed + Passwall + Docker 增量包选择 —— 叠加到 diffconfig_uz801（上游90行配置全保留）
# 应用方式见 scripts/apply-daed-config.sh（会追加到 openwrt/.config）
# 保留原作者全部功能（luci/modemmanager/wireguard/usb-gadget/zram/wcn36xx WiFi 等）不动。

# ================= daed（大鹅，dae 内核级透明代理，kenzok8/openwrt-daede feed）=================
# 包名以 feed 实际为准：后端是 daed（带 dashboard）；luci 前端是 luci-app-daede，
# 其依赖由 choice 选择后端（daed 或 dae）——选 daed 后端。
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daede=y
CONFIG_PACKAGE_luci-app-daede_daed=y

# ================= Passwall（第2版：已移除）=================
# v2 去掉 Passwall，只保留 daed 一套透明代理，避免两套科学抢 tproxy/nft 规则、
# 512MB 内存双栈吃紧。daed 是 Passwall+xray 的替代品，不叠加。
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_passwall_packages_xray-core is not set
# CONFIG_PACKAGE_passwall_packages_sing-box is not set
# CONFIG_PACKAGE_passwall_packages_chinadns-ng is not set
# CONFIG_PACKAGE_passwall_packages_geoview is not set

# ================= Docker（保留原作者没带、用户要的容器能力）=================
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_dockerd-tini=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-extra=y
CONFIG_PACKAGE_kmod-nf-ipvs=y
CONFIG_PACKAGE_kmod-fs-ext4=y

# ================= daed / tc-bpf 运行时用户态工具 =================
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y

# ================= BPF/eBPF 编译工具链（daed bpf-headers 必需）=================
# 上次失败根因：bpf.mk 里 BPF_TOOLCHAIN 默认选到非 HOST 分支，CLANG 解析成
#   /invalid/clang → "LLVM/clang version too old, found: (空)"。
# 修法：强制用宿主机 LLVM 工具链（workflow 已装 clang-14 并软链 /usr/bin/clang），
# 空 PATH 前缀让 bpf.mk 直接在系统 PATH 找 clang。避免走 BUILD_LLVM 从源码编
# LLVM（极慢且易 OOM）。互斥项一并关掉，防止 make defconfig 反选回默认。
# CONFIG_BPF_TOOLCHAIN_HOST select USE_LLVM_HOST；HOST_PATH 留空=用系统 PATH。
# CONFIG_HAS_PREBUILT_LLVM_TOOLCHAIN 由架构决定，此处显式选 HOST 分支覆盖之。
# CONFIG_BPF_TOOLCHAIN_HOST_PATH="" 必须保留（bpf.mk qstrip 后为空即走裸 PATH）。
# 注意：以下三行是 choice 成员，只能有一个 =y，其余需为 is not set。
# CONFIG_BPF_TOOLCHAIN_BUILD_LLVM is not set
# CONFIG_BPF_TOOLCHAIN_PREBUILT is not set
# CONFIG_BPF_TOOLCHAIN_NONE is not set
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_BPF_TOOLCHAIN_HOST_PATH=""

# 说明：
# - 384MB 内存 + ~3.8G eMMC：daed + Passwall + Docker 全塞，flash 够，但**同时运行**
#   内存吃紧。建议实际用时按需起服务，别三个代理栈+一堆容器同时拉满。
# - Passwall 与 daed 是两套独立透明代理，别同时开（会抢 tproxy/nft 规则）；按需二选一启用。

# ================= MT7601U 外置 USB WiFi 网卡（360随身WiFi，联发科 MT7601）=================
# 用户 2026-08-11 拍板：本轮连同 BPF 修复一起编进去。板载 wcn36xx AP 锁 6.5M 是硬件
# bug，外置 MT7601 网卡发热点不受影响。物理口通过 USB hub 解决（用户确认）。
# mt7601u 主线驱动 + 官方固件 blob，无需手搓交叉编译。
CONFIG_PACKAGE_kmod-mt7601u=y
CONFIG_PACKAGE_mt7601u-firmware=y
# 免驱「光驱」坑：360WiFi 插上默认伪装成 U盘/光驱(idVendor 148f)，需 usb-modeswitch 切网卡模式。
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_kmod-usb-net=y
# 外置网卡当 AP 发热点需 wpad-openssl 支持 WPA2；若与基线 wpad 冲突 make defconfig 自动取舍。
CONFIG_PACKAGE_wpad-openssl=y
