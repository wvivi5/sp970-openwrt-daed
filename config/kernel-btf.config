# daed(大鹅) 所需内核选项 —— 叠加到 hkfuertes/msm8916-openwrt 的 msm89xx/config-6.12
# 应用方式见 scripts/apply-daed-config.sh
# 已在上游 config-6.12 (内核 6.12) 实地验证不冲突、无畸形 (2026-08-11)
#
# 上游现状（改前）：
#   # CONFIG_NET_SCHED is not set     <- 整个 tc 子系统关着，daed 的 clsact 无处挂
#   CONFIG_DEBUG_INFO_REDUCED=y       <- 与 BTF 互斥，必须关
#   （无 CONFIG_DEBUG_INFO_BTF）       <- 要加
#   已有: CONFIG_NET_EGRESS=y / CONFIG_NET_INGRESS=y / CONFIG_BPF_JIT_ALWAYS_ON=y

# --- 关闭与 BTF 互斥项 ---
# CONFIG_DEBUG_INFO_REDUCED is not set

# --- BTF (daed CO-RE 必需) ---
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# --- tc / clsact (透明代理挂载点)，上游默认 NET_SCHED 关闭 ---
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y

# --- BPF / cgroup-bpf / veth (daed 必需) ---
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_VETH=y
CONFIG_XDP_SOCKETS=y
